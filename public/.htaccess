# =============================================================================
# Start2Code — Apache config for Hostinger (and any other Apache host).
#
# This file lives in public/ so Vite copies it into dist/ on every build.
# Upload it alongside index.html; without it, refreshing any page other than
# the home page returns a 404.
# =============================================================================

# --- Never execute the Python teaching files -------------------------------
# runner.html fetches py-runtime.py as plain text. Some shared hosts have a CGI
# handler bound to .py, which would try to RUN it on the server instead.
<FilesMatch "\.py$">
  RemoveHandler .py
  ForceType text/plain
</FilesMatch>

<IfModule mod_mime.c>
  AddType text/plain .py
  AddType application/wasm .wasm
  AddType application/javascript .js
  AddType application/json .json
  AddType image/svg+xml .svg
</IfModule>

# --- Single page app routing ------------------------------------------------
# React Router owns the URLs. Anything that is not a real file on disk has to
# be handed to index.html so the app can route it itself.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- Supabase through our own domain --------------------------------------
  # Must come before everything below it: these paths are not files on disk, and
  # both the 404 rule (a project is a .sb3) and the index.html fallback would
  # otherwise swallow them. See public/sb/proxy.php for why this exists.
  RewriteRule ^sb/ sb/proxy.php [L,QSA]

  # Leave real files and folders alone (index.html, scratch.html, runner.html,
  # /static/..., /assets/..., /vendor/...).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # A MISSING asset must 404, never fall through to index.html.
  #
  # Vite fingerprints its bundles, so the filename changes on every deploy. A
  # browser holding a cached index.html asks for the previous bundle; if that
  # request is answered with index.html, the browser parses HTML as JavaScript
  # and throws "Uncaught SyntaxError: Unexpected token '<'" — a confusing error
  # a long way from its cause. A plain 404 is honest, and lets the recovery
  # handler in index.html notice and reload.
  RewriteRule \.(js|mjs|css|map|json|wasm|py|png|jpe?g|gif|svg|ico|webp|woff2?|ttf|eot|mp3|wav|sb3)$ - [L,R=404]

  RewriteRule ^ index.html [L]
</IfModule>

# --- Caching ----------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # Vite fingerprints these, so they can be cached hard.
  <FilesMatch "\.(js|css|woff2?)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, immutable"
  </FilesMatch>

  # The Scratch asset library is versioned by filename too.
  <FilesMatch "\.(png|jpe?g|gif|svg|mp3|wav|ttf)$">
    ExpiresDefault "access plus 6 months"
  </FilesMatch>

  # index.html must never be cached, or students keep loading the old app
  # after an update.
  <FilesMatch "^index\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Compression ------------------------------------------------------------
# The Scratch bundle is 17 MB uncompressed and about 4 MB gzipped.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
                                application/javascript application/json image/svg+xml
</IfModule>
